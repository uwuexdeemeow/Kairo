{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairo",
  "version": "0.7.0",
  "identifier": "com.kairo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairo",
        "visible": false,
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#0e0f12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Kairo",
    "shortDescription": "Screen time tracker that shows when you focus best",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3NkNFNzJGREJENEI1MDUKUldRRnRkVGJMK2RzUjhCdUQ4NXJNZEdnNHFBbDAvK2lZQWxPaTFsZHM2dmxiZy9ETWQxekNJU3QK",
      "endpoints": ["https://github.com/uwuexdeemeow/Kairo/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
